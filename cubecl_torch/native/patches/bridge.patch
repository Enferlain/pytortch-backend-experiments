+            .finish()
+    }
+}
+
+impl ObserverSlot {
+    /// Reports to `observer` from now on, or to none.
+    pub fn set(&self, observer: Option<alloc::sync::Arc<dyn CompilationObserver>>) {
+        *self.0.write() = observer;
+    }
