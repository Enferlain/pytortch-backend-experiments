
# Local Python environments and caches (source and lockfiles stay visible).
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Native build products; generated kernel evidence is curated per stage.
target/
*.so
*.o
*.a

# Downloaded upstream sources are setup inputs, not vendored dependencies.
/.stage0-sources/*/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Raw profiler captures contain sensitive process environment data.
/stage5/artifacts/reduction-structure/repeatability/nsys-state.nsys-rep
/stage5/artifacts/reduction-structure/repeatability/nsys-state.sqlite
