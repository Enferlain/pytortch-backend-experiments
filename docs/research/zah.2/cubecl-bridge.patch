@@ -0,0 +1,22 @@
+//! Bridge prototype (cubecl_torch zah.2): run a call on a stream someone else owns.
+
+use core::cell::Cell;
+use cudarc::driver::sys::CUstream;
+
+std::thread_local! {
+    static STREAM: Cell<Option<CUstream>> = const { Cell::new(None) };
+}
+
+/// Run `f` with every server call it makes on this thread issued to `stream`,
+/// a stream the caller owns. Needs a synchronous device handle: the calls must
+/// run on this thread, inside `f`.
+pub fn on_stream<R>(stream: u64, f: impl FnOnce() -> R) -> R {
+    let previous = STREAM.with(|s| s.replace(Some(stream as CUstream)));
+    let result = f();
+    STREAM.with(|s| s.set(previous));
+    result
+}
+
+pub(crate) fn current() -> Option<CUstream> {
+    STREAM.with(|s| s.get())
+}
